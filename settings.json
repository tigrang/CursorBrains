{
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.showFiles": true,
  "breadcrumbs.symbolPath": "on",
  "cursor.composer.queueManualSendBehavior2": "steer",
  "cursor.composer.queueMessageDefaultBehavior": "steer",
  "editor.bracketPairColorization.enabled": false,
  "editor.fontFamily": "Monaco, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.fontWeight": "normal",
  "editor.guides.bracketPairs": false,
  "editor.letterSpacing": 0,
  "editor.lineHeight": 22,
  "editor.stickyScroll.defaultModel": "outlineModel",
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "explorer.autoReveal": true,
  "explorer.compactFolders": true,
  "explorer.decorations.badges": false,
  "explorer.excludeGitIgnore": false,
  "explorer.fileNesting.enabled": false,
  "explorer.sortOrder": "default",
  "gitblame.authorNameStyle": "first",
  "gitBrain.telemetry.enabled": false,
  "scratchpads.showInExplorer": true,
  "search.defaultViewMode": "tree",
  "spyglass.closeOnSelect": false,
  "spyglass.showWhatsNew": false,
  "terminal.integrated.fontFamily": "Monaco, monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.quickSuggestions": {
    "arguments": "on",
    "commands": "on",
    "unknown": "on"
  },
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "window.autoDetectColorScheme": true,
  "window.openFoldersInNewWindow": "on",
  "window.zoomLevel": 0.25,
  "workbench.activityBar.location": "default",
  "workbench.activityBar.orientation": "vertical",
  "workbench.agentsWindowButton.enabled": false,
  "workbench.colorCustomizations": {
    "editorStickyScroll.shadow": "#000000b3"
  },
  "workbench.editor.decorations.badges": false,
  "workbench.enableExperiments": false,
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-dark",
  "workbench.preferredLightColorTheme": "IntelliJ IDEA New UI Dark",
  "workbench.preferredDarkColorTheme": "IntelliJ IDEA New UI Dark",
  "workbench.sideBar.location": "left",
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.indent": 18,
  "workbench.tree.renderIndentGuides": "none"
}